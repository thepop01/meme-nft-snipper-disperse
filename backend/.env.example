# --- TradeForge sniper backend configuration ---

# Explicit local-development mode. Production deployments must override this to
# NODE_ENV=production and provide API_TOKEN (the Docker compose file does so).
NODE_ENV=development
ALLOW_INSECURE_LOCAL_AUTH=true

# Server bind and port for REST API + WebSocket. Keep loopback for local use.
HOST=127.0.0.1
PORT=4517

# Bearer token required for every /api request and the /ws socket.
# Send it only as Authorization: Bearer <token>; URL query tokens are rejected.
# Production requires a non-empty, high-entropy token.
API_TOKEN=

# Explicit origins allowed to call the API from a browser. These are the
# local Vite and Docker dashboard origins; add deployment origins explicitly.
# Wildcard (*) is not permitted.
CORS_ORIGINS=http://localhost:5173,http://localhost:3080

# Unauthenticated access is available only when NODE_ENV=development/test and
# HOST is loopback. Leave this false in shared environments.
ALLOW_INSECURE_LOCAL_AUTH=false

# Solana RPC endpoints. Public mainnet RPC works for testing but is heavily
# rate-limited — a free Helius (helius.dev) or QuickNode endpoint is strongly
# recommended for reliable discovery and trading.
RPC_URL=https://api.mainnet-beta.solana.com
WSS_URL=wss://api.mainnet-beta.solana.com

# SAFETY: paper-trading mode. Bots simulate buys/sells against live market
# data without spending anything. Set to false ONLY when you have reviewed
# your bot parameters and are ready to trade real SOL.
DRY_RUN=true

# Second, independent live-mode interlock. Both DRY_RUN=false and
# LIVE_TRADING_ENABLED=true are required before a real trade can be prepared.
LIVE_TRADING_ENABLED=false

# Maximum SOL accepted by one live trade request.
MAX_TRADE_SOL=1

# Off by default. When false, manual live trades must be signed by a connected
# browser wallet. Enable only after a separate server-signer security review.
ALLOW_SERVER_SIGNER=false

# Trading wallet secret key (base58, e.g. exported from Phantom).
# Only required when DRY_RUN=false. Keep this file out of git.
# WALLET_SECRET_KEY=

# Default priority fee in microlamports per compute unit
PRIORITY_FEE_MICROLAMPORTS=100000

# Optional Jito tip in lamports (0 = disabled)
JITO_TIP_LAMPORTS=0

# Optional EVM RPC overrides used by Disperse and NFT checks. The built-in
# public endpoints are suitable for light testing; use dedicated provider
# URLs for reliable production traffic.
# RPC_ETH=https://ethereum-rpc.publicnode.com
# RPC_BASE=https://mainnet.base.org
# RPC_ARB=https://arb1.arbitrum.io/rpc
# RPC_OP=https://mainnet.optimism.io
# RPC_POLYGON=https://polygon-bor-rpc.publicnode.com
# RPC_BSC=https://bsc-dataseed.binance.org
# RPC_AVAX=https://api.avax.network/ext/bc/C/rpc
# RPC_MONAD=https://rpc.monad.xyz
# Robinhood has no verified public default; configure it before NFT gas or eligibility calls.
# RPC_ROBINHOOD=

# Disperse has its own fail-safe. Keep dry-run enabled until every intended
# chain has been tested and the deployed Disperse contract bytecode hash has
# been independently verified. Live EVM execution fails closed without a hash.
DISPERSE_DRY_RUN=true
# DISPERSE_BYTECODE_HASH_ETH=0x...
# DISPERSE_BYTECODE_HASH_BASE=0x...
# DISPERSE_BYTECODE_HASH_ARB=0x...
# DISPERSE_BYTECODE_HASH_OP=0x...
# DISPERSE_BYTECODE_HASH_POLYGON=0x...
# DISPERSE_BYTECODE_HASH_BSC=0x...
# DISPERSE_BYTECODE_HASH_AVAX=0x...
# DISPERSE_BYTECODE_HASH_MONAD=0x...
# Postgres event tape
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tradeforge

# --- Intelligence & Wallet Sources ---
# MadeOnSol API Key (early snipers & migration events)
MADEONSOL_API_KEY=your_madeonsol_api_key_here

# Optional Free Tier Integrations
# BIRDEYE_API_KEY=your_birdeye_api_key_here          # Free at https://bds.birdeye.so (100k CU/mo)
# SOLSCAN_API_KEY=your_solscan_api_key_here          # Free at https://pro-api.solscan.io

